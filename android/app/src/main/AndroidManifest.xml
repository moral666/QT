<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mensagens de voz (ate 10 s): pedida so quando se carrega no microfone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notificacoes (Android 13+): "Tens mensagens novas", sem conteudo. Pedida uma vez. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Chamadas de voz: servico em primeiro plano com o microfone (sem ele, o Android corta o
         microfone quando a app sai do ecra), altifalante/auricular e vibracao ao tocar. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Chamadas com a app fechada ou o telemovel bloqueado (fase 4b): o ecra da chamada
         abre por cima do bloqueio (notificacao de ecra inteiro, so para chamadas). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- allowBackup=false + dataExtractionRules: o ficheiro SQLCipher so abre com a chave
         do Keystore deste aparelho; nem backup na nuvem nem copia entre aparelhos
         (Android 12+ ignora allowBackup na copia direta, dai as regras). -->
    <application
        android:name=".SealerApp"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.QT">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Abrir um ficheiro recebido noutra app (leitor de PDF, etc.): a outra app le-o
             da memoria desta, sem copia decifrada em disco (ver Files.kt). So com a
             permissao dada no momento, por cada ficheiro. -->
        <provider
            android:name=".SealerFileProvider"
            android:authorities="${applicationId}.ficheiros"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Chamada de voz em curso (Calls.kt): mantem o microfone com a app fora do ecra. -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- "Recusar" na notificacao da chamada a chegar (Calls.kt). -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
        <!-- Notificacoes (FCM, ver Push.kt): a campainha do relay (vazia, ou marcada como chamada). -->
        <service
            android:name=".SealerPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- O Firebase e iniciado a mao (Push.init), so com o Cloud Messaging: sem o
             FirebaseInitProvider automatico, sem token antes de a app o pedir e sem
             recolha de dados de utilizacao. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mensagens" />
        <!-- Leitor de QR (biblioteca ZXing Android Embedded): por omissao so funciona
             deitado; assim roda com o telemovel. A permissao da camara e pedida so
             quando se carrega em "Ler codigo QR". -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>
