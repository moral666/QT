// Definicoes comuns (Debug e Release). Valores do relay em Relay.xcconfig.
//
// Para assinar no teu iPhone cria ios/Configs/Local.xcconfig (NAO vai para o git) com:
//   DEVELOPMENT_TEAM = <o teu Team ID, ver Xcode > Settings > Accounts>
//   PRODUCT_BUNDLE_IDENTIFIER = pt.<teunome>.sealer   // so se "sealer.app" estiver ocupado na tua conta
//   QT_ENTITLEMENTS = SealerMessenger/SealerMessenger.entitlements   // so com a conta paga da Apple:
//                                                                    // liga as notificacoes e o toque das chamadas
// (ou escolhe a equipa no separador "Signing & Capabilities" do Xcode).

PRODUCT_NAME = SealerMessenger
// O mesmo identificador da app Android (desde a 0.9.0). Nunca mudar depois de publicar.
PRODUCT_BUNDLE_IDENTIFIER = sealer.app
// Mesma versao que a app Android com as mesmas funcionalidades (android/app/build.gradle.kts).
MARKETING_VERSION = 0.9.20
CURRENT_PROJECT_VERSION = 27
// Notificacoes (Push Notifications): a conta gratuita da Apple nao as permite. Sem o
// QT_ENTITLEMENTS no Local.xcconfig a app compila e funciona, sem notificacoes.
CODE_SIGN_ENTITLEMENTS = $(QT_ENTITLEMENTS)
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
CODE_SIGN_STYLE = Automatic
INFOPLIST_FILE = SealerMessenger/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_BITCODE = NO
DEAD_CODE_STRIPPING = YES
// O script de verificacao do relay so le variaveis de build (nao precisa de ficheiros).
ENABLE_USER_SCRIPT_SANDBOXING = NO

#include "Relay.xcconfig"
#include? "Local.xcconfig"
