#include "Base.xcconfig"

// Debug: relay editavel em "Opcoes de teste" e ws:// permitido (relay local no Mac).
// Valor inicial: o relay de producao (Relay.xcconfig), como no iPhone a serio. Para um relay
// no proprio Mac (simulador), mudar em "Opcoes de teste" para ws://127.0.0.1:9443.
QT_RELAY_EDITABLE = YES
QT_ALLOW_CLEARTEXT = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
DEBUG_INFORMATION_FORMAT = dwarf
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
