<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-PT</string>
	<key>CFBundleDisplayName</key>
	<string>SEALER</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Textos dos pedidos de permissao: traduzidos em Resources/<lingua>.lproj/InfoPlist.strings -->
	<key>NSCameraUsageDescription</key>
	<string>Para ler o código QR de outra pessoa e adicioná-la aos contactos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Para as chamadas de voz e as mensagens de voz.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Para desbloquear a SEALER sem escrever o código.</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt-PT</string>
		<string>en</string>
		<string>fr</string>
		<string>es</string>
		<string>de</string>
		<string>it</string>
		<string>ja</string>
		<string>zh-Hans</string>
		<string>hi</string>
		<string>ar</string>
	</array>
	<!-- Chamadas de voz: tocar com a app fechada (PushKit + CallKit) e continuar em segundo plano. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<!-- Cifra ponta a ponta (algoritmos normalizados, codigo aberto): ver docs/export-compliance.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Sem excecoes globais. So permite redes locais (relay de teste no Mac), e so na
		     Debug: na Release esta chave e tirada depois da build (project.yml). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Relay (preenchido a partir de ios/Configs/*.xcconfig) -->
	<key>QTRelayURL</key>
	<string>$(QT_RELAY_URL)</string>
	<key>QTRelayPin</key>
	<string>$(QT_RELAY_PIN)</string>
	<key>QTRelayEditable</key>
	<string>$(QT_RELAY_EDITABLE)</string>
	<key>QTAllowCleartext</key>
	<string>$(QT_ALLOW_CLEARTEXT)</string>
	<!-- Letras: Manrope (marca) e Plus Jakarta Sans (texto), as mesmas do Android -->
	<key>UIAppFonts</key>
	<array>
		<string>Manrope-Bold.ttf</string>
		<string>PlusJakartaSans-Regular.ttf</string>
		<string>PlusJakartaSans-Medium.ttf</string>
		<string>PlusJakartaSans-SemiBold.ttf</string>
		<string>PlusJakartaSans-Bold.ttf</string>
		<string>PlusJakartaSans-ExtraBold.ttf</string>
	</array>
</dict>
</plist>
