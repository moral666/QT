# /etc/qt/relay.env  (root:qt, 0640)
# O relay so escuta em loopback; o TLS (wss://) e terminado pelo Caddy/nginx.
RELAY_BIND_ADDR=127.0.0.1:9443
# Redis local com ACL (ver deploy/redis/qt-redis.conf). Password em hex.
REDIS_URL=redis://qt-relay:SUBSTITUI_POR_PASSWORD_FORTE@127.0.0.1:6379
NOISE_KEY_PATH=/var/lib/qt/relay_noise_key.bin
# Imagens/GIFs (ja cifrados pelas apps), apagados ao fim de 24 h. Pasta por omissao:
# /var/lib/qt/anexos (ao lado da chave Noise). Ajusta o total ao disco livre.
RELAY_BLOB_MAX_TOTAL_MB=2048
RELAY_BLOB_USER_DAILY_MB=1024
# Espaco que fica sempre livre no disco; abaixo disto, imagens novas sao recusadas.
RELAY_BLOB_MIN_FREE_MB=1024
# RELAY_BLOBS=0   desativa os anexos
# Nunca definir em producao:
# QT_ALLOW_PUBLIC_BIND=1
# QT_ALLOW_REMOTE_REDIS=1
