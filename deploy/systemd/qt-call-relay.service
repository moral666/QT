# Relay das CHAMADAS (so voz; UDP 443 + reserva WebSocket em 127.0.0.1:9445, atras do
# HAProxy em wss://<nome>/call). Instalado pelo deploy/aws/setup-ec2.sh. Desde a 0.9.53 o
# video das chamadas vai so pela ligacao direta entre contactos mutuos, nunca por aqui.
#
# Processo a parte do relay das mensagens: precisa de receber UDP da Internet (o
# qt-relay so fala com localhost), mas nao tem acesso as contas: nao le /etc/qt/relay.env
# (onde esta a password do Redis das contas) nem fala com o Redis. So le a chave Noise do relay
# (a do pin, para abrir os pedidos de entrada nas salas). Nada em disco, sem registos com IPs.

[Unit]
Description=QT relay das chamadas, so voz (UDP 443, salas anonimas)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qt
Group=qt
Environment=NOISE_KEY_PATH=/var/lib/qt/relay_noise_key.bin
Environment=CALL_UDP_BIND=0.0.0.0:443
Environment=CALL_WS_BIND=127.0.0.1:9445
# Limites: no drop-in qt-call-relay.service.d/limites.conf, gerado pelo setup-ec2.sh. Para
# mudar, passa o valor ao script uma vez (ex.: sudo CALL_MAX_ROOMS=4000 bash setup-ec2.sh);
# as atualizacoes seguintes mantem-no.
#   CALL_MAX_ROOMS (2000), CALL_ROOMS_PER_IP (20), CALL_PACKETS_PER_SEC (100)
ExecStart=/usr/local/bin/qt-call-relay
Restart=on-failure
RestartSec=2

LimitNOFILE=16384
LimitCORE=0

# --- Isolamento ---
# So a permissao para abrir a porta 443 (abaixo de 1024) sem ser root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/qt
InaccessiblePaths=-/etc/qt -/var/lib/qt/anexos
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
