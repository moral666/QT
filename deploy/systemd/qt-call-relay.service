# Relay das CHAMADAS DE VOZ (UDP 443 + reserva WebSocket em 127.0.0.1:9445, atras do
# HAProxy em wss://<nome>/call). Instalado pelo deploy/aws/setup-ec2.sh.
#
# Processo a parte do relay das mensagens: precisa de receber UDP da Internet (o
# qt-relay so fala com localhost), mas nao tem acesso ao Redis nem as contas: nao le
# /etc/qt/relay.env (onde esta a password do Redis). So le a chave Noise do relay, a
# do pin, para abrir os pedidos de entrada nas salas. Sem registos com IPs.

[Unit]
Description=QT relay das chamadas de voz (UDP 443, salas anonimas)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qt
Group=qt
Environment=NOISE_KEY_PATH=/var/lib/qt/relay_noise_key.bin
Environment=CALL_UDP_BIND=0.0.0.0:443
Environment=CALL_WS_BIND=127.0.0.1:9445
# Limites (para mudar, um drop-in em /etc/systemd/system/qt-call-relay.service.d/):
#   CALL_MAX_ROOMS (2000), CALL_ROOMS_PER_IP (20), CALL_PACKETS_PER_SEC (100)
ExecStart=/usr/local/bin/qt-call-relay
Restart=on-failure
RestartSec=2

LimitNOFILE=16384
LimitCORE=0

# --- Isolamento ---
# So a permissao para abrir a porta 443 (abaixo de 1024) sem ser root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/qt
InaccessiblePaths=-/etc/qt -/var/lib/qt/anexos
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
