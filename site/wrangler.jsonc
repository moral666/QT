// Publicação na Cloudflare: Worker "sealer".
// Dentro desta pasta: npm run build && npx wrangler deploy (ver README.md, secção 5).
// Publicação automática: cada push para o ramo ligado em Settings > Builds.
{
  "name": "sealer",
  "compatibility_date": "2026-10-16",
  // Só os pedidos a /api/* correm este código; o resto são ficheiros estáticos de dist/.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Relays da SEALER na AWS, em federação (os mesmos endereços wss:// das apps, escritos com
    // https://). O marcador de estado no canto do site verifica cada um e mostra um ponto por
    // relay. Nomes iguais aos das apps (qtRelayName / qtRelaysOutros).
    "RELAYS": [
      { "nome": "estocolmo", "url": "https://relay.sealerapp.com" },
      { "nome": "espanha", "url": "https://relay-es.sealerapp.com" }
    ],
    // De que relay vem o tempo "entre telemóveis" (se ainda não tiver medições: o primeiro que tiver).
    "RELAY_TEMPO": "espanha"
  },
  "routes": [
    { "pattern": "sealerapp.com", "custom_domain": true },
    { "pattern": "www.sealerapp.com", "custom_domain": true }
  ],
  // false: o site só existe em sealerapp.com (sem o endereço *.workers.dev da conta).
  "workers_dev": false,
  "preview_urls": false
}
